# Zodiac 环境变量示例（复制为 .env.local 后按需填写）

# SQLite 数据库文件位置（默认 <项目>/data/zodiac.db）
# ZODIAC_DB_PATH=./data/zodiac.db

# 时区，用于按天归档（默认 Asia/Shanghai）
# ZODIAC_TZ=Asia/Shanghai

# 关闭应用内定时同步（设为 off）
# ZODIAC_SCHEDULER=off

# 可选：启用 Claude 增强点评（不配置则仅使用启发式分析）
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# 可选：GitHub Releases API token（不配置则匿名访问，失败回退 git tags）
# GITHUB_TOKEN=
